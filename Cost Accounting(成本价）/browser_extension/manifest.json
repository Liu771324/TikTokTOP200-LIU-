{
  "manifest_version": 3,
  "name": "抖店到手价成本夹板",
  "version": "0.1.0",
  "description": "只读解析抖店最低到手价，并展示聚水潭成本、估算运费、基础服务费和真实成本。",
  "key": "",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://fxg.jinritemai.com/ffa/merchant/*-campaign-detail*",
        "https://fxg.jinritemai.com/ffa/g/create*"
      ],
      "js": [
        "core.js",
        "panel.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
